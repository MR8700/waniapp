{
  "name": "waniapp",
  "version": "1.0.0",
  "description": "WANI APP — Commande mobile-first, comptoir & temps réel (Mooré: Wani = emmener, venir avec, apporter)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/main.js",
    "build": "node -e \"console.log('Build WANI APP prêt pour déploiement')\"",
    "admin": "node --disable-warning=ExperimentalWarning server/make-admin.js",
    "seed": "node --disable-warning=ExperimentalWarning server/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "deploy": "node scripts/deploy.js",
    "deploy:ps1": "powershell -ExecutionPolicy Bypass -File ./deploy.ps1",
    "deploy:sh": "bash ./deploy.sh"
  }
}

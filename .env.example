# ==============================================================================
# WANI APP — Variables d'Environnement
# Mooré : WANI = « Emmener, venir avec, apporter »
# ==============================================================================

# Clé cryptographique secrète pour la signature HMAC et le chiffrement des sessions
# (Générée automatiquement en local si absente, recommandée sur Vercel en variable d'environnement)
APP_SECRET=changez_moi_en_production_par_une_chaine_aleatoire_de_64_caracteres

# Répertoire de stockage SQLite et des fichiers média (local: ./data, Vercel: /tmp/wani-data)
DATA_DIR=./data

# Port d'écoute pour l'exécution locale
PORT=3000

# Environnement d'exécution (development | production)
NODE_ENV=production
